{
  "$schema": "https://docs.umbraco.com/assets/umbraco-package-schema.json",
  "name": "CropGuard",
  "version": "1.0.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "crop-guard.dashboard",
      "name": "CropGuard",
      "element": "/App_Plugins/CropGuard/dashboard.element.js",
      "weight": -100,
      "meta": {
        "label": "CropGuard",
        "pathname": "crop-guard"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    }
  ]
}
