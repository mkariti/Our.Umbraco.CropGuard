<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Our.Umbraco.CropGuard</RootNamespace>
    <AssemblyName>Our.Umbraco.CropGuard</AssemblyName>

    <!-- NuGet package metadata -->
    <PackageId>Our.Umbraco.CropGuard</PackageId>
    <Version>1.0.0</Version>
    <Authors>Moshe Kariti</Authors>
    <Company>Moshe Kariti</Company>
    <Product>CropGuard for Umbraco</Product>
    <Description>Protects Umbraco image processing from abuse by only allowing pre-defined crops to proceed through the ImageSharp pipeline. Prevents resource exhaustion from arbitrary resize parameters.</Description>
    <Copyright>Copyright © 2026 Moshe Kariti</Copyright>
    <PackageTags>umbraco;umbraco-marketplace;imagesharp;security;image-processing;middleware;ddos-protection</PackageTags>
    <PackageProjectUrl>https://github.com/mkariti/Our.Umbraco.CropGuard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mkariti/Our.Umbraco.CropGuard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release with dynamic crop detection, static crop configuration, and custom crop dashboard.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Icon is optional — package can be published without it -->
  <PropertyGroup Condition="Exists('icon.png')">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- ASP.NET Core APIs (HttpContext, IMiddleware, etc.) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" Version="17.0.0" />
  </ItemGroup>

  <!-- Store App_Plugins at the package root so the .targets file can locate them -->
  <ItemGroup>
    <None Include="App_Plugins\**\*">
      <Pack>true</Pack>
      <PackagePath>App_Plugins\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    </None>
  </ItemGroup>

  <!--
    MSBuild .targets file auto-imported by consuming projects.
    Copies App_Plugins to wwwroot/App_Plugins/ at build time.
    This will be replaced by Static Web Assets once the project migrates to SDK.Razor.
  -->
  <ItemGroup>
    <None Include="build\Our.Umbraco.CropGuard.targets">
      <Pack>true</Pack>
      <PackagePath>build\Our.Umbraco.CropGuard.targets</PackagePath>
    </None>
  </ItemGroup>

  <!-- Include README and icon in the package -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" Condition="Exists('icon.png')" />
  </ItemGroup>

</Project>
