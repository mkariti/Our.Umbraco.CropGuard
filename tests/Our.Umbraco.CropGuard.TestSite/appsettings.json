{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Our.Umbraco.CropGuard": "Debug"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "8ac47e57-1c8d-4d72-9050-6985e5e34bc8"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      }
    }
  },
  "CropGuard": {
    "Enabled": true,
    "MediaPathPrefix": "/media",
    "AllowOriginalImage": true,
    "LogBlockedRequests": true,
    "StaticCrops": [
      { "Width": 1920, "Height": 1080, "Alias": "hero" },
      { "Width": 1200, "Height": 630,  "Alias": "ogImage" },
      { "Width": 800,  "Height": 600,  "Alias": "landscape" },
      { "Width": 400,  "Height": 400,  "Alias": "square" },
      { "Width": 300,  "Height": 200,  "Alias": "thumbnail" }
    ]
  }
}
